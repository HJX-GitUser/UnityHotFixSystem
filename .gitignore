# =====================================================================
# 本仓库根目录 = Assets/Scripts/Hotfix/
# 只提交框架源码与文档；编辑器/系统杂项、Unity 生成物、构建产物一律忽略。
# 说明：.meta 文件需要入库，它提供稳定 GUID，导入他人工程时脚本引用才不会丢。
# =====================================================================

# ---------------------------------------------------------------------
# 1. 编辑器 / 系统杂项
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.lnk
/.vs/
/.idea/
*.DotSettings.user
*.sln.DotSettings.user
*.user
*.suo
*.userprefs
.vscode/*.log

# ---------------------------------------------------------------------
# 2. Unity 生成物（在本目录另开 Unity 工程时才会出现）
# ---------------------------------------------------------------------
/Library/
/Temp/
/obj/
/Logs/
/UserSettings/
/MemoryCaptures/
/Build/
/Builds/
/*.csproj
/*.sln
/*.unityproj
/*.pidb
/*.booproj
/*.svd
/*.opendb
/*.VC.db
/*.pdb
/*.mdb
sysinfo.txt
crashlytics-build.properties

# ---------------------------------------------------------------------
# 3. 构建产物（构建工具默认输出到工程根的 ServerData/hotfix）
# ---------------------------------------------------------------------
/ServerData/
*.bundle
